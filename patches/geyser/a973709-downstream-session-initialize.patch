+package org.geysermc.geyser.api.event.downstream;
+
+import org.geysermc.geyser.api.connection.GeyserConnection;
+import org.geysermc.geyser.api.event.connection.ConnectionEvent;
+import org.geysermc.mcprotocollib.network.ClientSession;
+
+import java.util.Objects;
+
+/**
+ * Called after Geyser creates the Java downstream session and registers its
+ * protocol listener, but before Geyser registers its packet translator or
+ * starts the downstream connection.
+ *
+ * <p>Extensions may register session listeners during this event. They must
+ * not connect, replace, or close the downstream session.</p>
+ */
+public final class DownstreamSessionInitializeEvent extends ConnectionEvent {
+    private final ClientSession downstreamSession;
+
+    public DownstreamSessionInitializeEvent(GeyserConnection connection, ClientSession downstreamSession) {
+        super(connection);
+        this.downstreamSession = Objects.requireNonNull(downstreamSession, "downstreamSession");
+    }
+
+    /**
+     * Returns the newly created MCProtocolLib client session.
+     *
+     * @return the downstream session
+     */
+    public ClientSession downstreamSession() {
+        return this.downstreamSession;
+    }
+}
